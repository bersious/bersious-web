{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/tmn",
      "destination": "/project.html"
    },
    {
      "source": "/tmn/",
      "destination": "/project.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/tmn/index.html",
      "destination": "/tmn",
      "statusCode": 301
    }
  ]
}
